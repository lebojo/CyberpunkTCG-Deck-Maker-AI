# Copie ce fichier en .env et remplis-le (start.sh le fait pour toi).

# Token API Infomaniak (manager.infomaniak.com > Développeurs > Tokens API, scope "ai_tools")
INFOMANIAK_TOKEN=

# ID du produit AI Tools (visible dans l'URL du manager AI Tools)
INFOMANIAK_PRODUCT_ID=

# Modèle présélectionné dans la page (optionnel)
INFOMANIAK_MODEL=google/gemma-4-31B-it

# Port du serveur local
PORT=8000
